# Copy to .env.local (git-ignored) and fill in. These values end up in the public
# bundle — they are protected by the restrictions set in Google Cloud, not by secrecy.

# Google Cloud → Google Auth Platform → Clients → Web application → Client ID
VITE_GOOGLE_CLIENT_ID=

# Google Cloud → APIs & Services → Credentials → API key (restricted to Sheets API + your sites)
VITE_SHEETS_API_KEY=

# From the Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
VITE_SHEET_ID=

# Tab name + columns to read
VITE_SHEET_RANGE=Data!A1:F
